# Cloudflare Pages response headers — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Keep the admin panel out of search engines and never cache it.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Store data changes whenever the admin panel publishes — always revalidate.
/assets/js/data.js
  Cache-Control: no-cache

# Don't serve the project notes as a page.
/README.md
  X-Robots-Tag: noindex
